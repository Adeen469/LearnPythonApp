{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/logo.png"
      },
      "package": "com.learnpython.app",
      "permissions": [
        "REQUEST_INSTALL_PACKAGES"
      ],
      "predictiveBackGestureEnabled": false
    },
    "icon": "./assets/logo.png",
    "ios": {
      "bundleIdentifier": "com.learnpython.app",
      "supportsTablet": true
    },
    "name": "Learn Python",
    "orientation": "portrait",
    "plugins": [
      "expo-secure-store",
      "expo-video",
      "expo-web-browser",
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-localization"
    ],
    "scheme": "learnpython",
    "slug": "learn-python",
    "splash": {
      "backgroundColor": "#000000",
      "image": "./assets/logo.png",
      "resizeMode": "contain"
    },
    "userInterfaceStyle": "dark",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/logo.png"
    }
  }
}
